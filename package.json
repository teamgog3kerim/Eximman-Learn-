    "@types/cors": "^2.8.19",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
