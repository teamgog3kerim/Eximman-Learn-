# Configure these in EthioDeploy's encrypted project environment settings.
# Never commit real values. VITE_* values are bundled into the browser build.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
VITE_CLERK_PROXY_URL=/api/__clerk

# VITE_CLERK_PUBLISHABLE_KEY must match CLERK_PUBLISHABLE_KEY.
# EthioDeploy supplies PORT automatically; do not set it manually.
